{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6bd5\u4e1a\u8bc1\u6837\u672c\u4e0e\u5927\u5b66\u6bd5\u4e1a\u8bc1\u8865\u529e\u5168\u653b\u7565","text":"<p>\u5728\u6c42\u804c\u843d\u6237\u3001\u804c\u79f0\u8bc4\u5ba1\u6216\u51fa\u56fd\u7559\u5b66\u7b49\u91cd\u8981\u65f6\u523b\uff0c\u5927\u5b66\u6bd5\u4e1a\u8bc1\u4f5c\u4e3a\u5b66\u5386\u7684\u6838\u5fc3\u51ed\u8bc1\uff0c\u5176\u91cd\u8981\u6027\u4e0d\u8a00\u800c\u55bb\u3002\u7136\u800c\uff0c\u4e0d\u5c11\u6bd5\u4e1a\u751f\u4f1a\u9762\u4e34\u8bc1\u4e66\u4e0d\u614e\u9057\u5931\u6216\u635f\u574f\u7684\u7a98\u5883\u3002</p> <p>\u90a3\u4e48\uff0c\u771f\u6b63\u7684\u6bd5\u4e1a\u8bc1\u6837\u672c\u662f\u4ec0\u4e48\u6837\u7684\uff1f\u5927\u5b66\u6bd5\u4e1a\u8bc1\u4e22\u4e86\u5230\u5e95\u80fd\u4e0d\u80fd\u8865\u529e\uff1f\u5982\u679c\u4e0d\u80fd\uff0c\u8be5\u5982\u4f55\u901a\u8fc7\u6b63\u89c4\u6e20\u9053\u633d\u6551\uff1f</p> <p></p> <p>\u672c\u6587\u5c06\u4e3a\u60a8\u5168\u9762\u89e3\u6790\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6559\u80b2\u90e8\u76d1\u5236\u7684\u666e\u901a\u9ad8\u7b49\u5b66\u6821\u6bd5\u4e1a\u8bc1\u4e66\u89c4\u8303\uff0c\u5e76\u5e26\u6765\u6700\u65b0\u3001\u6700\u6743\u5a01\u7684\u5927\u5b66\u6bd5\u4e1a\u8bc1\u8865\u529e\uff08\u7533\u9886\u6bd5\u4e1a\u8bc1\u660e\u4e66\uff09\u5168\u6d41\u7a0b\u6307\u5357\u3002</p>"},{"location":"#_2","title":"\ud83c\udfaf \u6807\u51c6\u666e\u901a\u5927\u5b66\u6bd5\u4e1a\u8bc1\u6837\u672c\u5305\u542b\u54ea\u4e9b\u6838\u5fc3\u8981\u7d20\uff1f","text":"<p>\u6839\u636e\u6559\u80b2\u90e8\u7684\u76f8\u5173\u89c4\u5b9a\uff0c\u6b63\u89c4\u7684\u9ad8\u7b49\u5b66\u6821\u6bd5\u4e1a\u8bc1\u4e66\u4ece\u5c01\u9762\u5230\u5185\u9875\u90fd\u6709\u6781\u5176\u4e25\u683c\u7684\u9632\u4f2a\u4e0e\u6392\u7248\u89c4\u8303\u3002</p>"},{"location":"#1","title":"1. \u5c01\u9762\u5916\u89c2","text":"<p>\u6807\u51c6\u7684\u5927\u5b66\u6bd5\u4e1a\u8bc1\u5c01\u9762\u901a\u5e38\u4e3a\u6df1\u84dd\u8272\u9ad8\u7ea7\u76ae\u8d28\u7eb9\u7406\u8d28\u611f\u3002\u6b63\u4e2d\u592e\u5370\u6709\u91d1\u8272\u7684\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u56fd\u5fbd\uff0c\u56fd\u5fbd\u4e0b\u65b9\u4e3a\u9192\u76ee\u7684\u91d1\u8272\u201c\u6bd5\u4e1a\u8bc1\u4e66\u201d\u56db\u4e2a\u5927\u5b57\uff0c\u6700\u5e95\u90e8\u5219\u6807\u6ce8\u6709\u201c\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6559\u80b2\u90e8\u76d1\u5236\u201d\u5b57\u6837\u3002</p>"},{"location":"#2","title":"2. \u5185\u9875\u5173\u952e\u4fe1\u606f","text":"<p>\u7ffb\u5f00\u5185\u9875\uff0c\u4e00\u4efd\u5408\u89c4\u7684\u6bd5\u4e1a\u8bc1\u5fc5\u987b\u5305\u542b\u4ee5\u4e0b\u4fe1\u606f\uff0c\u7f3a\u4e00\u4e0d\u53ef\uff1a *   \u4e2a\u4eba\u57fa\u672c\u4fe1\u606f\uff1a\u6bd5\u4e1a\u751f\u59d3\u540d\u3001\u6027\u522b\u3001\u51fa\u751f\u5e74\u6708\u65e5\u3002 *   \u5b66\u4e1a\u4fee\u8bfb\u4fe1\u606f\uff1a\u5165\u6821\u65f6\u95f4\u3001\u6bd5\u4e1a\u65f6\u95f4\u3001\u6240\u5b66\u4e13\u4e1a\u3001\u5b66\u5236\uff08\u5982\u56db\u5e74\u5236\u672c\u79d1\u3001\u4e09\u5e74\u5236\u4e13\u79d1\uff09\u3002 *   \u6bd5\uff08\u7ed3\uff09\u4e1a\u7ed3\u8bba\uff1a\u660e\u786e\u5199\u6709\u201c\u4fee\u5b8c\u6559\u5b66\u8ba1\u5212\u89c4\u5b9a\u7684\u5168\u90e8\u8bfe\u7a0b\uff0c\u6210\u7ee9\u5408\u683c\uff0c\u51c6\u4e88\u6bd5\u4e1a\u201d\u3002 *   \u6743\u5a01\u5370\u7ae0\uff1a\u5b66\u6821\u540d\u79f0\u53ca\u6821\u672c\u90e8\u516c\u7ae0\u3001\u73b0\u4efb\u6821\u957f\uff08\u9662\uff08\u6821\uff09\u957f\uff09\u7684\u7b7e\u540d\u7ae0\u3002 *   \u552f\u4e00\u8bc6\u522b\u7801\uff1a\u6781\u5176\u91cd\u8981\u7684\u8bc1\u4e66\u7f16\u53f7\uff08\u5373\u5b66\u4fe1\u7f51\u53ef\u67e5\u7684\u5b66\u5386\u8bc1\u4e66\u7535\u5b50\u6ce8\u518c\u53f7\uff09\u3002</p>"},{"location":"#_3","title":"\u2753 \u5927\u5b66\u6bd5\u4e1a\u8bc1\u4e22\u4e86\u80fd\u8865\u529e\u539f\u4ef6\u5417\uff1f","text":"<p>\u5f88\u591a\u540c\u5b66\u53d1\u73b0\u6bd5\u4e1a\u8bc1\u4e22\u5931\u540e\uff0c\u7b2c\u4e00\u53cd\u5e94\u662f\u8054\u7cfb\u6bcd\u6821\u201c\u80fd\u4e0d\u80fd\u91cd\u65b0\u5370\u4e00\u5f20\u539f\u6a21\u539f\u6837\u7684\u6bd5\u4e1a\u8bc1\uff1f\u201d</p> <p>\u7b54\u6848\u662f\uff1a\u4e0d\u80fd\u3002</p> <p>\u6839\u636e\u6559\u80b2\u90e8\u9881\u5e03\u7684\u300a\u666e\u901a\u9ad8\u7b49\u5b66\u6821\u5b66\u751f\u7ba1\u7406\u89c4\u5b9a\u300b\u7b2c\u4e09\u5341\u516b\u6761\u660e\u786e\u89c4\u5b9a\uff1a</p> <p>\u201c\u5b66\u5386\u8bc1\u4e66\u548c\u5b66\u4f4d\u8bc1\u4e66\u9057\u5931\u6216\u8005\u635f\u574f\uff0c\u7ecf\u5b66\u751f\u7533\u8bf7\uff0c\u5b66\u6821\u6838\u5b9e\u540e\u5e94\u5f53\u51fa\u5177\u76f8\u5e94\u7684\u8bc1\u660e\u4e66\u3002\u8bc1\u660e\u4e66\u4e0e\u539f\u8bc1\u4e66\u5177\u6709\u540c\u7b49\u6548\u529b\u3002\u201d</p>"},{"location":"#_4","title":"\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u8865\u53d1\u539f\u4ef6\uff1f","text":"<ol> <li>\u552f\u4e00\u6027\uff1a\u6bcf\u4e00\u5f20\u5927\u5b66\u6bd5\u4e1a\u8bc1\u4e66\u7684\u7f16\u53f7\u5728\u51fa\u5382\u548c\u5b66\u4fe1\u7f51\u6ce8\u518c\u65f6\u90fd\u662f\u552f\u4e00\u7684\uff0c\u5c5e\u4e8e\u4e00\u6b21\u6027\u5370\u5237\u7684\u9632\u4f2a\u8bc1\u5238\uff0c\u65e0\u6cd5\u4e8c\u6b21\u590d\u5236\u3002</li> <li>\u65f6\u6548\u6027\uff1a\u8bc1\u4e66\u4e0a\u5fc5\u987b\u6709\u4f60\u6bd5\u4e1a\u5f53\u5e74\u6821\u957f\u7684\u4eb2\u7b14\u7b7e\u540d\u7ae0\u3002\u5982\u679c\u6821\u957f\u5df2\u7ecf\u8c03\u4efb\u6216\u9000\u4f11\uff0c\u5b66\u6821\u65e0\u6cd5\u518d\u4f7f\u7528\u5176\u5370\u7ae0\u7b7e\u7f72\u3002</li> </ol> <p>\u26a0\ufe0f \u7279\u522b\u63d0\u9192\uff1a\u5343\u4e07\u4e0d\u8981\u8f7b\u4fe1\u7f51\u4e0a\u6240\u8c13\u7684\u201c100%\u539f\u7248\u5b9a\u5236\u201d\u3001\u201c\u5feb\u901f\u4ee3\u529e\u539f\u4ef6\u201d\u7684\u975e\u6cd5\u5e7f\u544a\u3002\u5012\u5356\u3001\u4f2a\u9020\u6216\u8d2d\u4e70\u865a\u5047\u56fd\u5bb6\u673a\u5173\u8bc1\u4ef6\u5c5e\u4e8e\u8fdd\u6cd5\u884c\u4e3a\u3002</p>"},{"location":"#_5","title":"\ud83d\udccb \u6b63\u89c4\u201c\u5927\u5b66\u6bd5\u4e1a\u8bc1\u8865\u529e\u201d\u6d41\u7a0b\uff08\u6bd5\u4e1a\u8bc1\u660e\u4e66\u7533\u9886\uff09","text":"<p>\u867d\u7136\u65e0\u6cd5\u8865\u529e\u539f\u4ef6\uff0c\u4f46\u5b66\u6821\u5b98\u65b9\u51fa\u5177\u7684\u6bd5\u4e1a\u8bc1\u660e\u4e66\u5728\u6cd5\u5f8b\u6548\u529b\u3001\u8003\u516c\u3001\u8003\u7814\u3001\u5165\u804c\u653f\u5ba1\u3001\u51fa\u56fd\u7559\u5b66\u3001\u804c\u79f0\u8bc4\u5b9a\u7b49\u65b9\u9762\uff0c\u4e0e\u539f\u6bd5\u4e1a\u8bc1\u5b8c\u5168\u7b49\u540c\u3002\u4ee5\u4e0b\u662f\u6b63\u89c4\u7684\u8865\u529e\u6b65\u9aa4\uff1a</p>"},{"location":"#_6","title":"\u7b2c\u4e00\u6b65\uff1a\u51c6\u5907\u8bc1\u660e\u6750\u6599","text":"<p>\u529e\u7406\u524d\uff0c\u4f60\u9700\u8981\u5411\u6bcd\u6821\u7684\u6559\u52a1\u5904\u6216\u6863\u6848\u9986\u63d0\u4ea4\u4ee5\u4e0b\u57fa\u7840\u6750\u6599\uff08\u4e0d\u540c\u9ad8\u6821\u8981\u6c42\u53ef\u80fd\u7565\u6709\u5dee\u5f02\uff0c\u5efa\u8bae\u63d0\u524d\u81f4\u7535\u6821\u65b9\u786e\u8ba4\uff09\uff1a *   \u8eab\u4efd\u8bc1\u539f\u4ef6\u53ca\u6b63\u53cd\u9762\u590d\u5370\u4ef6\u3002 *   \u8fd1\u671f\u514d\u51a0\u84dd\u5e95\u6216\u767d\u5e95\u8bc1\u4ef6\u7167\uff1a\u901a\u5e38\u9700\u8981\u4e24\u5f20\u7eb8\u8d28\u7248\u53ca\u540c\u5e95\u7248\u7535\u5b50\u7167\u7247\uff0c\u7528\u4e8e\u7c98\u8d34\u5728\u8bc1\u660e\u4e66\u4e0a\u5e76\u4e0a\u62a5\u6559\u80b2\u90e8\u5e73\u53f0\u3002 *   \u5b66\u5386\u68c0\u7d22\u8bc1\u660e\uff1a\u767b\u5f55\u201c\u4e2d\u56fd\u9ad8\u7b49\u6559\u80b2\u5b66\u751f\u4fe1\u606f\u7f51\uff08\u5b66\u4fe1\u7f51\uff09\u201d\u6253\u5370\u7684\u300a\u6559\u80b2\u90e8\u5b66\u5386\u8bc1\u4e66\u7535\u5b50\u6ce8\u518c\u5907\u6848\u8868\u300b\u3002 *   \u5b66\u7c4d\u6863\u6848\u590d\u5370\u4ef6\uff1a\u5982\u5f53\u5e74\u5165\u5b66\u5f55\u53d6\u5ba1\u6279\u8868\u3001\u6bd5\u4e1a\u751f\u6210\u7ee9\u5355\u7b49\uff08\u901a\u5e38\u53ef\u5728\u5b66\u6821\u6863\u6848\u9986\u51ed\u8eab\u4efd\u8bc1\u73b0\u573a\u590d\u5370\uff09\u3002</p>"},{"location":"#_7","title":"\u7b2c\u4e8c\u6b65\uff1a\u5411\u6bcd\u6821\u6559\u52a1\u5904\u63d0\u51fa\u7533\u8bf7","text":"<p>\u643a\u5e26\u4e0a\u8ff0\u6750\u6599\u524d\u5f80\u5b66\u6821\u6559\u52a1\u5904\u5b66\u7c4d\u7ba1\u7406\u79d1\uff0c\u586b\u5199\u300a\u9ad8\u7b49\u5b66\u6821\u8865\u529e\u6bd5\u4e1a\u8bc1\u660e\u4e66\u7533\u8bf7\u8868\u300b\u3002\u90e8\u5206\u9ad8\u6821\u76ee\u524d\u5df2\u5f00\u901a\u7ebf\u4e0a\u529e\u4e8b\u5927\u5385\uff0c\u652f\u6301\u90ae\u5bc4\u529e\u7406\uff0c\u6781\u5927\u5730\u65b9\u4fbf\u4e86\u5916\u5730\u6821\u53cb\u3002</p>"},{"location":"#_8","title":"\u7b2c\u4e09\u6b65\uff1a\u5b66\u6821\u6838\u5b9e\u5e76\u5236\u4f5c\u8bc1\u660e\u4e66","text":"<p>\u6559\u52a1\u5904\u5b66\u7c4d\u79d1\u4f1a\u8c03\u53d6\u4f60\u7684\u5f55\u53d6\u3001\u5728\u6821\u3001\u6bd5\u4e1a\u6570\u636e\u8fdb\u884c\u4e25\u683c\u6bd4\u5bf9\u3002\u6838\u5bf9\u65e0\u8bef\u540e\uff0c\u5b66\u6821\u4f1a\u4e3a\u4f60\u5236\u4f5c\u4e00\u5f20\u5168\u65b0\u7684\u201c\u6bd5\u4e1a\u8bc1\u660e\u4e66\u201d\uff0c\u4e0a\u9762\u4f1a\u8d34\u4e0a\u65b0\u7167\u7247\uff0c\u76d6\u4e0a\u5b66\u6821\u73b0\u6709\u7684\u516c\u7ae0\u3001\u73b0\u4efb\u6821\u957f\u7ae0\uff0c\u5e76\u660e\u786e\u6807\u6ce8\u201c\u56e0\u539f\u8bc1\u4e66\u9057\u5931\uff0c\u7279\u6b64\u8bc1\u660e\u201d\u3002</p>"},{"location":"#_9","title":"\u7b2c\u56db\u6b65\uff1a\u5b66\u4fe1\u7f51\u4fe1\u606f\u6807\u6ce8","text":"<p>\u5b66\u6821\u5728\u53d1\u653e\u8bc1\u660e\u4e66\u7684\u540c\u65f6\uff0c\u4f1a\u5c06\u76f8\u5173\u4fe1\u606f\u62a5\u9001\u81f3\u6559\u80b2\u5385\u53ca\u6559\u80b2\u90e8\u5e73\u53f0\uff0c\u5728\u4f60\u7684\u5b66\u4fe1\u7f51\u7535\u5b50\u6863\u6848\u4e2d\u8fdb\u884c\u201c\u52a8\u6001\u5173\u8054\u201d\u6216\u6807\u6ce8\uff0c\u786e\u4fdd\u8bc1\u660e\u4e66\u7684\u771f\u5b9e\u53ef\u67e5\u6027\u3002</p>"},{"location":"#_10","title":"\ud83d\udca1 \u6bd5\u4e1a\u8bc1\u9632\u4e22\u4e0e\u5e94\u6025\u66ff\u4ee3\u65b9\u6848","text":"<ol> <li>\u59a5\u5584\u7559\u5b58\u7535\u5b50\u7248\uff1a\u65e5\u5e38\u62ff\u5230\u6bd5\u4e1a\u8bc1\u540e\uff0c\u52a1\u5fc5\u7b2c\u4e00\u65f6\u95f4\u4f7f\u7528\u9ad8\u6e05\u626b\u63cf\u4eea\u6216\u624b\u673a\u626b\u63cf\u8f6f\u4ef6\uff0c\u5c06\u8bc1\u4e66\u6b63\u53cd\u9762\u3001\u5916\u58f3\u4fdd\u5b58\u4e3a\u9ad8\u6e05 PDF \u548c JPG \u683c\u5f0f\uff0c\u5b58\u653e\u5728\u4e91\u76d8\u4e2d\u5907\u7528\u3002</li> <li>\u5584\u7528\u5b66\u4fe1\u7f51\u62a5\u544a\uff1a\u5728\u7edd\u5927\u591a\u6570\u7ebf\u4e0a\u6c42\u804c\u3001\u8d44\u683c\u8003\u8bd5\u62a5\u540d\u573a\u666f\u4e2d\uff0c\u5e76\u4e0d\u9700\u8981\u51fa\u793a\u7eb8\u8d28\u539f\u4ef6\u3002\u76f4\u63a5\u51fa\u793a\u5728\u6709\u6548\u671f\u5185\u7684\u5b66\u4fe1\u7f51\u5728\u7ebf\u9a8c\u8bc1\u62a5\u544a\u5373\u53ef\u83b7\u5f97\u5168\u793e\u4f1a\u516c\u8ba4\u3002</li> </ol>"},{"location":"#_11","title":"\u270d\ufe0f \u7ed3\u8bed","text":"<p>\u5927\u5b66\u6bd5\u4e1a\u8bc1\u627f\u8f7d\u7740\u6211\u4eec\u591a\u5e74\u7684\u5bd2\u7a97\u82e6\u8bfb\u3002\u5982\u679c\u4e0d\u614e\u9057\u5931\uff0c\u4e0d\u5fc5\u614c\u5f20\uff0c\u8bf7\u52a1\u5fc5\u901a\u8fc7\u6bcd\u6821\u5b98\u65b9\u6559\u52a1\u6e20\u9053\u7533\u8bf7\u6bd5\u4e1a\u8bc1\u660e\u4e66\u3002\u7d27\u8ddf\u6b63\u89c4\u6d41\u7a0b\uff0c\u65e2\u80fd\u9ad8\u6548\u89e3\u51b3\u6c42\u804c\u3001\u843d\u6237\u7684\u71c3\u7709\u4e4b\u6025\uff0c\u53c8\u80fd\u5f7b\u5e95\u675c\u7edd\u8d2d\u4e70\u5047\u8bc1\u5e26\u6765\u7684\u6cd5\u5f8b\u98ce\u9669\u3002</p>"}]}